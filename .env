# VoyageIQ Pro — Configuration Environnement (.env)
# SQLite Edition
# IMPORTANT :
# - Ajouter .env dans .gitignore
# - Ne jamais exposer ce fichier publiquement
# ═══════════════════════════════════════════════════════════════

# ── Flask ─────────────────────────────────────────────────────
FLASK_ENV=development
FLASK_APP=run.py

# ── Sécurité ──────────────────────────────────────────────────
SECRET_KEY=voyageiq-pro-2026-secure-key-paulo-masse

# ── Base de données SQLite ────────────────────────────────────
# Le fichier sera utilisé automatiquement :
# /database/voyageiq.db
# (Pas besoin de DATABASE_URL si settings.py utilise SQLite par défaut)

# Optionnel si tu veux le définir explicitement :
DATABASE_URL=sqlite:///database/voyageiq.db

